{
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/anytimetiffin",
      "destination": "/AnyTimeTiffin/index.html"
    },
    {
      "source": "/anytimetiffin/",
      "destination": "/AnyTimeTiffin/index.html"
    },
    {
      "source": "/anytimetiffin/:path*",
      "destination": "/AnyTimeTiffin/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
