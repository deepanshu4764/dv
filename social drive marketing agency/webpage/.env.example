PORT=3000

# Keep this secret stable in production. Generate it with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=replace-with-a-long-random-secret
OTP_TTL_SECONDS=300
OTP_RESEND_LIMIT=3
OTP_ATTEMPT_LIMIT=5
LOGIN_ATTEMPT_LIMIT=5
LOGIN_WINDOW_SECONDS=900
SESSION_TTL_SECONDS=604800

# MSG91 OTP integration.
SMS_PROVIDER=msg91
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=
SMS_TEMPLATE_ID=
